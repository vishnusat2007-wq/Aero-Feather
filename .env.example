# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — hosted Checkout + webhooks
# Prefer a restricted key (rk_live_ / rk_test_) with Checkout Sessions write
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Not required for hosted Checkout redirect; keep for Dashboard / future Stripe.js
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public site URL — apex only (avoid www TLS issues)
NEXT_PUBLIC_APP_URL=https://aero-feather.vercel.app

# Only this email is promoted to admin on signup
ADMIN_EMAIL=
